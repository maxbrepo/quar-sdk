int increment(int x) { return x + 1; }
int plus_two(int x) { return x + 2; }
int apply(function(int)->int callback, int x = 41) {
    local_copy = callback;
    return (local_copy)(x);
}
original = &increment;
copy = original;
original = &plus_two;
first = apply(callback = copy);
second = apply(callback = original);
print(first);
print(second);
