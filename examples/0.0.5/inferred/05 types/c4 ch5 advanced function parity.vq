int increment(int x) { return x + 1; }
int factorial(int x) {
    if (x <= 1) { return 1; }
    return x * factorial(x - 1);
}
int apply(function(int)->int cb, int x = 41) { return (cb)(x); }
int forward(function(int)->int cb, int x) { return apply(cb, x); }
bool check(function(int)->bool cb, int x) { return (cb)(x); }

callback = &increment;
direct = apply(callback);
print(direct);
callback = lambda(int x)->int { return x + 2; };
forwarded = forward(callback, 40);
print(forwarded);
recursive = &factorial;
factorial_result = (recursive)(5);
print(factorial_result);
predicate = lambda(int x)->bool { return x > 0; };
positive = check(predicate, 1);
print(positive);
named = apply(x = 41, cb = &increment);
print(named);
