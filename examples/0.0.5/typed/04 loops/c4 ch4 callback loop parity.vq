int increment(int x) { return x + 1; }
int fold(function(int)->int callback, int limit) {
    int i = 0;
    int total = 0;
    while (i < limit) {
        total = total + (callback)(i);
        i = i + 1;
    }
    return total;
}
function callback = &increment;
int result = fold(callback, 3);
print(result);
